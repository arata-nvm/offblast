---
interface Props {
    haiku: string; // "上五 中七 下五"（空白区切り）
    lawName: string;
    siteUrl: string;
}
const { haiku, lawName, siteUrl } = Astro.props;
const ku = haiku.split(" ");
const shareText = `${haiku}\n- ${lawName}`;
const shareUrl = `https://twitter.com/intent/tweet?text=${encodeURIComponent(shareText)}&url=${encodeURIComponent(siteUrl)}`;
---

<figure class="card">
    <div class="haiku">
        <div class="inner">
            {ku.map((k, i) => <p class={`ku ku-${i + 1}`}>{k}</p>)}
        </div>
        <a
            class="share"
            href={shareUrl}
            target="_blank"
            rel="noopener"
            aria-label="Xでシェア"
        >
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
                ><path
                    fill="currentColor"
                    d="M18.9 1.6h3.4l-7.4 8.5L23.6 22h-6.8l-5.3-7-6.1 7H2l7.9-9.1L1.4 1.6h7l4.8 6.4 5.7-6.4Zm-1.2 18.4h1.9L7.1 3.5H5.1l12.6 16.5Z"
                ></path></svg
            >
        </a>
    </div>
</figure>

<style>
    .card {
        flex-shrink: 0;
        width: max-content;
    }
    .haiku {
        position: relative;
        writing-mode: vertical-rl;
        height: min(80dvh, 56em);
        width: max-content;
    }
    .inner {
        box-sizing: border-box;
        height: 100%;
        border: 5px solid var(--frame);
        background: var(--card);
        padding: clamp(16px, 3dvh, 30px) 16px;
    }
    .ku {
        box-sizing: border-box;
        height: 100%;
        margin: 0;
        padding: 0 7px;
        font-family: "Noto Serif JP", serif;
        font-size: clamp(1.8rem, 5dvh, 3.2rem);
        white-space: nowrap;
    }
    .ku-1 {
        text-align: start;
    }
    .ku-2 {
        text-align: center;
    }
    .ku-3 {
        text-align: end;
    }

    .share {
        position: absolute;
        right: 14px;
        bottom: 14px;
        color: var(--frame);
        opacity: 0.6;
    }
    .share svg {
        display: block;
    }
    .share:hover {
        opacity: 1;
    }
</style>
