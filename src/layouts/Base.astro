---
import { href } from "../lib/data.ts";
interface Props {
    title?: string;
}
const { title = "OffBlast" } = Astro.props;
---

<!doctype html>
<html lang="ja">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{title}</title>
        <meta
            name="description"
            content="日本の法令にひそむ五七五（575）を見つけて縦書きで表示します。"
        />
        <link rel="icon" href={href("favicon.svg")} />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500&family=Noto+Serif+JP:wght@500;600&display=swap"
            rel="stylesheet"
        />
    </head>
    <body>
        <slot />
        <style is:global>
            :root {
                --bg: #faf8f4;
                --ink: #222;
                --accent: #9b7c3f;
                --frame: #b3ab9b;
                --card: #f4f5f7;
            }
            * {
                box-sizing: border-box;
            }
            body {
                margin: 0;
                font-family:
                    -apple-system, BlinkMacSystemFont, "Noto Sans JP",
                    "Segoe UI", Roboto, sans-serif;
                color: var(--ink);
                background: var(--bg);
            }
            main {
                width: 100%;
                max-width: 1100px;
                margin: auto;
                padding: 12px 32px;
                box-sizing: border-box;
            }
            a {
                color: var(--accent);
                text-decoration: none;
            }
            a:hover {
                text-decoration: underline;
            }
        </style>
    </body>
</html>
