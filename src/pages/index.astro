---
import Base from "../layouts/Base.astro";
import { laws } from "../lib/data.ts";

const items = laws.flatMap((law) =>
    law.haikus.map((haiku) => ({
        haiku: haiku.split(" ").join("　"),
        law: law.name,
        url: law.url,
    })),
);
const siteUrl = Astro.site
    ? new URL(Astro.url.pathname, Astro.site).href
    : Astro.url.href;
---

<Base>
    <main class="stage" id="stage" aria-label="法令の俳句">
        <noscript>
            <ul class="static">
                {
                    items.map((it) => (
                        <li>
                            {it.haiku} —{" "}
                            <a href={it.url} target="_blank" rel="noopener">
                                {it.law}
                            </a>
                        </li>
                    ))
                }
            </ul>
        </noscript>
    </main>

    <p class="src">出典： e-Gov 法令API</p>

    <script define:vars={{ items, siteUrl }}>
        const stage = document.getElementById("stage");
        const rand = (min, max) => min + Math.random() * (max - min);

        const active = new Set();
        const rects = new Map();
        const pickItem = () => {
            const pool = items.map((_, i) => i).filter((i) => !active.has(i));
            return pool[Math.floor(Math.random() * pool.length)];
        };

        // リサイズで作り直すため、古いタイマーは世代番号で無効化する
        let generation = 0;

        function makePoem() {
            const poem = document.createElement("figure");
            poem.className = "poem";
            const haiku = document.createElement("p");
            haiku.className = "haiku";
            const side = document.createElement("div");
            side.className = "side";
            const law = document.createElement("a");
            law.className = "law";
            law.target = "_blank";
            law.rel = "noopener";
            const share = document.createElement("a");
            share.className = "share";
            share.target = "_blank";
            share.rel = "noopener";
            share.setAttribute("aria-label", "Xでシェア");
            share.innerHTML =
                '<svg viewBox="0 0 24 24" width="13" height="13" aria-hidden="true"><path fill="currentColor" d="M18.9 1.6h3.4l-7.4 8.5L23.6 22h-6.8l-5.3-7-6.1 7H2l7.9-9.1L1.4 1.6h7l4.8 6.4 5.7-6.4Zm-1.2 18.4h1.9L7.1 3.5H5.1l12.6 16.5Z"/></svg>';
            side.appendChild(law);
            side.appendChild(share);
            poem.appendChild(haiku);
            poem.appendChild(side);
            return poem;
        }

        function fill(poem, item, fs) {
            poem.style.fontSize = `${fs}px`;
            poem.querySelector(".haiku").textContent = item.haiku;
            const law = poem.querySelector(".law");
            law.textContent = item.law;
            law.title = item.law;
            law.href = item.url;
            const text = `${item.haiku}\n- ${item.law}`;
            poem.querySelector(".share").href =
                `https://twitter.com/intent/tweet?text=${encodeURIComponent(text)}&url=${encodeURIComponent(siteUrl)}`;
        }

        function findSpot(w, h) {
            const W = stage.clientWidth;
            const H = stage.clientHeight;
            const pad = 16;
            for (let t = 0; t < 40; t++) {
                const x = rand(0, Math.max(0, W - w));
                const y = rand(0, Math.max(0, H - h));
                let ok = true;
                for (const r of rects.values()) {
                    if (
                        x < r.x + r.w + pad &&
                        r.x < x + w + pad &&
                        y < r.y + r.h + pad &&
                        r.y < y + h + pad
                    ) {
                        ok = false;
                        break;
                    }
                }
                if (ok) return { x, y };
            }
            return null;
        }

        function cycle(poem, gen, baseFs, delay) {
            if (gen !== generation) return;
            setTimeout(() => {
                if (gen !== generation) return;
                const idx = pickItem();
                const item = items[idx];
                active.add(idx);
                // 日本語WebフォントはUnicode範囲で分割配信され、未取得のグリフを
                // 含む句は採寸後にフォントが差し替わって重なるため、読込を待つ
                (
                    document.fonts?.load(
                        '500 16px "Noto Serif JP"',
                        item.haiku + item.law,
                    ) ?? Promise.resolve()
                ).then(() => {
                    if (gen !== generation) {
                        active.delete(idx);
                        return;
                    }
                    fill(poem, item, baseFs * rand(0.75, 1.1));
                    const box = poem.getBoundingClientRect();
                    const spot = findSpot(box.width, box.height);
                    if (!spot) {
                        active.delete(idx);
                        cycle(poem, gen, baseFs, rand(800, 2400));
                        return;
                    }
                    rects.set(poem, {
                        x: spot.x,
                        y: spot.y,
                        w: box.width,
                        h: box.height,
                    });
                    poem.style.left = `${spot.x}px`;
                    poem.style.top = `${spot.y}px`;
                    const fadeIn = rand(2000, 3600);
                    const hold = rand(6000, 12000);
                    const fadeOut = rand(2000, 3600);
                    const gap = rand(1500, 5000);
                    poem.style.transitionDuration = `${fadeIn}ms`;
                    poem.classList.add("show");
                    setTimeout(() => {
                        if (gen !== generation) return;
                        poem.style.transitionDuration = `${fadeOut}ms`;
                        poem.classList.remove("show");
                        setTimeout(() => {
                            active.delete(idx);
                            rects.delete(poem);
                            cycle(poem, gen, baseFs, gap);
                        }, fadeOut);
                    }, fadeIn + hold);
                });
            }, delay);
        }

        function build() {
            generation++;
            const gen = generation;
            active.clear();
            rects.clear();
            stage.querySelectorAll(".poem").forEach((el) => el.remove());
            if (items.length === 0) return;

            const W = stage.clientWidth;
            const H = stage.clientHeight;
            // 句全体（約17文字）が縦に収まるフォントサイズを上限にする
            const baseFs = Math.max(16, Math.min(40, H / 22, W / 14));
            // 短冊1枚ぶんの占有面積から同時表示数を見積もる
            const unitArea = baseFs * 2.6 * (baseFs * 18);
            const cap = Math.max(
                1,
                Math.min(12, Math.floor((W * H) / (unitArea * 2.2))),
            );
            const n = Math.min(cap, items.length);
            for (let i = 0; i < n; i++) {
                const poem = makePoem();
                stage.appendChild(poem);
                cycle(poem, gen, baseFs, rand(0, 9000));
            }
        }

        // フォント読込前の採寸ずれを避けるため、読込後に開始する
        (document.fonts?.ready ?? Promise.resolve()).then(build);
        let timer;
        addEventListener("resize", () => {
            clearTimeout(timer);
            timer = setTimeout(build, 300);
        });
    </script>

    <style>
        .stage {
            position: relative;
            width: 100vw;
            max-width: none;
            height: calc(100dvh - 40px);
            margin: 0;
            padding: 0;
            overflow: hidden;
        }
        .stage :global(.poem) {
            position: absolute;
            margin: 0;
            display: flex;
            flex-direction: row-reverse;
            gap: 0.28em;
            opacity: 0;
            filter: blur(6px);
            transition-property: opacity, filter;
            transition-timing-function: ease-in-out;
            pointer-events: none;
        }
        .stage :global(.poem.show) {
            opacity: 1;
            filter: blur(0);
            pointer-events: auto;
        }
        .stage :global(.haiku) {
            writing-mode: vertical-rl;
            margin: 0;
            font-family: "Noto Serif JP", serif;
            font-size: 1em;
            font-weight: 500;
            color: var(--ink);
            white-space: nowrap;
        }
        /* Safariは縦書きの行内にinline-blockを混ぜると横位置がずれるため、
           横書きのflex列で法令名とアイコンを中央揃えする */
        .stage :global(.side) {
            align-self: flex-end;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
        }
        .stage :global(.law) {
            writing-mode: vertical-rl;
            font-family: "Noto Serif JP", serif;
            font-size: 0.4em;
            font-weight: 500;
            color: #8a8272;
            white-space: nowrap;
            /* 縦書きではmax-heightが文字送り方向の制約になることを利用し、
               長い法令名が俳句（40em強に相当）より長い短冊にならないよう省略する */
            max-height: 36em;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .stage :global(.share) {
            display: block;
            color: var(--frame);
            opacity: 0.6;
        }
        .stage :global(.share svg) {
            display: block;
        }
        .stage :global(.share:hover) {
            opacity: 1;
        }

        .static {
            padding: 24px 32px;
        }
        .static li {
            margin-bottom: 8px;
        }

        .src {
            position: fixed;
            right: 16px;
            bottom: 12px;
            margin: 0;
            color: #8a8272;
            font-size: 0.78rem;
        }
    </style>
</Base>
